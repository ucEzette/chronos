# =============================================
# CHRONOS Marketplace Environment Configuration
# =============================================

# ---------------------------------------------
# STORAGE PROVIDER
# Options: 'filebase' | 'ocean' | 'mock'
# Use 'mock' for development without real storage
# Use 'filebase' for production with Filebase IPFS
# Use 'ocean' for Ocean Protocol (future)
# ---------------------------------------------
NEXT_PUBLIC_STORAGE_PROVIDER=mock

# ---------------------------------------------
# FILEBASE CONFIGURATION
# Get credentials at: https://console.filebase.com/keys
# Create an IPFS bucket named 'chronos-files'
# ---------------------------------------------
FILEBASE_ACCESS_KEY=your_access_key_here
FILEBASE_SECRET_KEY=your_secret_key_here
FILEBASE_BUCKET=chronos-files
NEXT_PUBLIC_FILEBASE_GATEWAY=https://ipfs.filebase.io/ipfs

# ---------------------------------------------
# OCEAN PROTOCOL (Future Migration)
# Uncomment when ready to switch to Ocean
# ---------------------------------------------
# NEXT_PUBLIC_STORAGE_PROVIDER=ocean
# OCEAN_UPLOADER_URL=https://uploader.oceanprotocol.com
# OCEAN_ACCOUNT=your_ocean_account

# ---------------------------------------------
# DATAHAVEN (Legacy - kept for backward compatibility)
# Can be removed once fully migrated to Filebase
# ---------------------------------------------
NEXT_PUBLIC_RPC_URL=https://services.datahaven-testnet.network/testnet
NEXT_PUBLIC_WSS_URL=wss://services.datahaven-testnet.network/testnet
NEXT_PUBLIC_MSP_URL=https://deo-dh-backend.testnet.datahaven-infra.network/

# ---------------------------------------------
# BLOCKCHAIN CONFIGURATION
# ---------------------------------------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_id

# ---------------------------------------------
# SUPABASE CONFIGURATION
# For real-time cross-device sync
# Get credentials at: https://supabase.com → Settings → API
# ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ---------------------------------------------
# ADMIN DASHBOARD
# Set a secure password for /admin access
# ---------------------------------------------
NEXT_PUBLIC_ADMIN_PASSWORD=your_secure_password_here

# ---------------------------------------------
# OAUTH SOCIAL VERIFICATION
# Create developer apps to get these credentials:
# Discord: https://discord.com/developers/applications
# GitHub: https://github.com/settings/developers
# Twitter: https://developer.twitter.com (requires paid API)
# ---------------------------------------------

# Discord OAuth (Free)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# GitHub OAuth (Free)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Twitter OAuth (Paid API required - $100/month)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# App URL for OAuth callbacks (e.g., https://yourapp.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000
